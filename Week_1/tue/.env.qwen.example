LLM_API_KEY=replace-me
LLM_API_URL=https://YOUR_WORKSPACE_ID.eu-central-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen3.7-plus
LLM_PROVIDER=qwen
LLM_SYSTEM_PROMPT="Ты — полезный ассистент."
LLM_RESPONSE_FORMAT=json_schema
LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens
LLM_MAX_COMPLETION_TOKENS=180
LLM_MAX_WORDS=80
LLM_MAX_SENTENCES=3
LLM_TEMPERATURE=0.2
LLM_STOP_SEQUENCE="<END_OF_ANSWER>"
QWEN_DISABLE_THINKING_FOR_STRUCTURED=true
