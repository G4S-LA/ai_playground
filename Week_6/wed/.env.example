WEB_HOST=127.0.0.1
WEB_PORT=8080

# Reuse the corpus and SQLite vector index prepared previously.
DOCUMENTS_DIR=../../Week_5/mon/documents
INDEX_DB=../../Week_5/mon/data/document-index.db

# Both models are served by the same local Ollama process.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=180
