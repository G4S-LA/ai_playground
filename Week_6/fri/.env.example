# Выполните `python3 server.py init`, чтобы создать .env со случайным ключом.
SERVICE_API_KEY=replace-with-a-long-random-secret
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=300

# SQLite-файл с диалогами и сообщениями.
CHAT_DATABASE=data/local-chat.db
