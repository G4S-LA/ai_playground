LLM_API_KEY=replace-me
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-flash
LLM_SYSTEM_PROMPT="Ты — полезный ассистент. Отвечай кратко и по делу."
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120

# SQLite-файл со всеми чатами и их сообщениями.
LLM_HISTORY_DB=chat_history.sqlite3

# Порт локального веб-интерфейса.
WEB_PORT=5000

# В окно входят system, текущий вопрос и последние целые пары сообщений.
# Старая история остаётся в SQLite, но не отправляется, если не помещается.
# Длину генерации определяет API; max_tokens не отправляется.
LLM_CONTEXT_WINDOW_TOKENS=8192
# Это приближение для DeepSeek, фактические значения берём из API usage.
LLM_TOKEN_ENCODING=cl100k_base

# USD за 1 000 000 токенов. Заполните по тарифам своего провайдера/модели.
# Пустое значение означает неизвестную цену, а не бесплатный запрос.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_CACHED_INPUT_PRICE_PER_MILLION=
