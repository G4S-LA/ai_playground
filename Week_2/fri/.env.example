LLM_API_KEY=replace-me
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-flash
LLM_SYSTEM_PROMPT="Ты — полезный ассистент. Отвечай кратко и по делу."
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120

# Отдельная база пятницы. Не указывайте базу другого задания.
LLM_HISTORY_DB=chat_history.sqlite3
WEB_PORT=5000

# Начальные настройки новых чатов. После первого сообщения не меняются.
# sliding_window или facts. Branching доступен отдельно через копирование.
LLM_CONTEXT_STRATEGY=sliding_window
# Любое положительное целое число; текущий вопрос входит в N.
LLM_KEEP_RECENT_MESSAGES=10
LLM_CONTEXT_WINDOW_TOKENS=8192
LLM_FACTS_MAX_TOKENS=1024
LLM_TOKEN_ENCODING=cl100k_base

# USD за миллион токенов; пусто = стоимость неизвестна.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_CACHED_INPUT_PRICE_PER_MILLION=
