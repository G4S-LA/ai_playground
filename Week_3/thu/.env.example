# OpenAI-compatible Chat Completions API.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_SYSTEM_PROMPT=Ты — полезный ассистент. Соблюдай переданные инварианты и используй память только как контекст.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# Хранилище и веб-сервер.
MEMORY_DATA_DIR=data
WEB_HOST=127.0.0.1
WEB_PORT=8080
