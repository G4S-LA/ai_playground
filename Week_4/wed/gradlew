#!/bin/sh

# This course repository already contains Gradle Wrapper binaries in Week_4/tue.
# Reuse that checked-in wrapper while keeping this exercise's build independent.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} \
  -Dorg.gradle.appname=gradlew \
  -classpath "$APP_HOME/../tue/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
