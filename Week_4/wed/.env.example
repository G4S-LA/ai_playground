# OpenAI-compatible model with tool calling. Not required with --demo.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# Durable schedules and report history.
REPORT_DATA_FILE=data/news-reports.json
WEB_CHAT_DATA_FILE=data/web-chats.json
REPORT_TIME_ZONE=Europe/Moscow

# Public Hacker News API.
NEWS_API_BASE_URL=https://hacker-news.firebaseio.com/v0
NEWS_CANDIDATE_LIMIT=100

# Optional HTTP endpoint that receives completed reports as JSON.
REPORT_WEBHOOK_URL=

WEB_HOST=127.0.0.1
WEB_PORT=8080
