# OpenAI-compatible model with tool calling. Not required for the demo.
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Directory for the generated Excel workbook.
MULTI_MCP_OUTPUT_DIR=data

# Existing News MCP from Week_4/wed.
NEWS_API_BASE_URL=https://hacker-news.firebaseio.com/v0
NEWS_CANDIDATE_LIMIT=30
NEWS_DATA_FILE=data/news-mcp-state.json

# Hosted Frankfurter MCP (Streamable HTTP, no API key).
CURRENCY_MCP_URL=https://mcp.frankfurter.dev/

# Optional override for the ralscha/excel-mcp binary installed by ./setup-mcp.sh.
# Defaults to .mcp/excel-mcp.exe on Windows and .mcp/excel-mcp elsewhere.
EXCEL_MCP_EXECUTABLE=

WEB_HOST=127.0.0.1
WEB_PORT=8080
