WEB_HOST=127.0.0.1
WEB_PORT=8081

# By default Tuesday reuses Monday's corpus and SQLite index.
DOCUMENTS_DIR=../mon/documents
INDEX_DB=../mon/data/document-index.db

# Final answer generation: OpenAI-compatible Chat Completions API.
LLM_PROVIDER=api
LLM_API_KEY=replace-me
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat

# Embeddings stay local in Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# Optional offline generation: set LLM_PROVIDER=ollama.
OLLAMA_CHAT_MODEL=qwen3.5:4b
